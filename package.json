{
  "name": "isomorphic-compress",
  "version": "0.0.2",
  "description": "Isomorphic, native (de)compression with Compression Streams API and Node.js zlib",
  "keywords": [
    "compression",
    "decompression",
    "deflate",
    "gunzip",
    "gzip",
    "inflate",
    "zlib"
  ],
  "homepage": "https://github.com/jeremy-code/isomorphic-compress#readme",
  "bugs": "https://github.com/jeremy-code/isomorphic-compress/issues",
  "license": "MIT",
  "author": "Jeremy Nguyen <hi@jeremy.ng> (https://jeremy.ng)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremy-code/isomorphic-compress.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": {
      "node": "./src/node/*",
      "browser": "./src/browser/*",
      "default": "./src/browser/*"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "node": "./dist/node/*",
        "browser": "./dist/browser/*",
        "default": "./dist/browser/*"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "ci:publish": "./scripts/publish.sh"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  }
}
